<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manual do Humano — Todo mundo tá comentando</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0e0e12;
    --bg2:#16161c;
    --bubble-them:#25252e;
    --bubble-me:#3b7cff;
    --ig1:#f58529; --ig2:#dd2a7b; --ig3:#8134af;
    --text:#f2f2f5;
    --text-dim:#9a9aa5;
    --green:#25d366;
    --gold:#f5c451;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg); color:var(--text);
    font-family:'Inter', sans-serif;
    line-height:1.5;
  }
  .display{font-family:'Fraunces', serif;}
  .wrap{max-width:880px; margin:0 auto; padding:0 24px;}
  a{color:inherit;}

  .topbar{padding:18px 0; border-bottom:1px solid #232329;}
  .topbar .wrap{display:flex; justify-content:space-between; align-items:center;}
  .topbar .brand{font-family:'Fraunces'; font-weight:700; font-size:19px;}
  .topbar .brand span{background:linear-gradient(90deg,var(--ig1),var(--ig2),var(--ig3)); -webkit-background-clip:text; background-clip:text; color:transparent;}

  .hero{padding:70px 0 40px; text-align:center;}
  .hero .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--bg2); border:1px solid #2a2a33; border-radius:20px;
    padding:6px 16px; font-size:13px; color:var(--text-dim); margin-bottom:26px;
  }
  .hero .eyebrow .dot{width:8px; height:8px; border-radius:50%; background:var(--green); box-shadow:0 0 8px var(--green);}
  .hero h1{
    font-family:'Fraunces'; font-weight:700; font-size:clamp(34px,6vw,58px);
    line-height:1.08; margin-bottom:20px;
  }
  .hero h1 .grad{background:linear-gradient(90deg,var(--ig1),var(--ig2),var(--ig3)); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .hero p.sub{max-width:540px; margin:0 auto 34px; color:var(--text-dim); font-size:19px;}

  .cta-primary{
    display:inline-block;
    background:var(--bubble-me); color:#fff;
    font-weight:600; font-size:16px;
    padding:15px 32px; border-radius:30px; text-decoration:none;
    transition:0.2s;
  }
  .cta-primary:hover{background:#2f68e0; transform:translateY(-2px);}
  .cta-note{font-size:13px; color:var(--text-dim); margin-top:14px;}

  section{padding:60px 0;}
  .section-title{font-family:'Fraunces'; font-weight:700; font-size:clamp(26px,4vw,36px); text-align:center; margin-bottom:8px;}
  .section-sub{text-align:center; color:var(--text-dim); margin-bottom:44px; max-width:520px; margin-left:auto; margin-right:auto;}

  /* PHONE MOCK */
  .phone{
    width:320px; background:#000; border-radius:34px; padding:10px;
    margin:0 auto; box-shadow:0 30px 60px rgba(0,0,0,0.5);
    border:1px solid #2a2a33;
  }
  .phone .screen{
    background:var(--bg2); border-radius:24px; overflow:hidden;
    min-height:420px; display:flex; flex-direction:column;
  }
  .phone .chat-header{
    display:flex; align-items:center; gap:10px; padding:14px 16px;
    border-bottom:1px solid #232329;
  }
  .phone .avatar{
    width:34px; height:34px; border-radius:50%;
    background:linear-gradient(135deg,var(--ig1),var(--ig2),var(--ig3));
    display:flex; align-items:center; justify-content:center; font-size:16px;
  }
  .phone .chat-name{font-weight:600; font-size:14px;}
  .phone .chat-status{font-size:11px; color:var(--green);}
  .chat-body{padding:16px; display:flex; flex-direction:column; gap:10px; flex:1;}
  .bubble{
    max-width:78%; padding:10px 14px; border-radius:16px; font-size:14px; line-height:1.4;
  }
  .bubble.them{background:var(--bubble-them); align-self:flex-start; border-bottom-left-radius:4px;}
  .bubble.me{background:var(--bubble-me); align-self:flex-end; border-bottom-right-radius:4px; color:#fff;}
  .bubble.img-share{
    background:var(--bubble-them); align-self:flex-start; border-bottom-left-radius:4px;
    padding:0; overflow:hidden; width:70%;
  }
  .bubble.img-share .cap{
    background:linear-gradient(135deg,#1a1a22,#26262f);
    height:120px; display:flex; align-items:center; justify-content:center;
    font-family:'Fraunces'; font-weight:700; color:var(--gold); font-size:13px; text-align:center; padding:10px;
  }
  .bubble.img-share .meta{padding:8px 12px; font-size:12px; color:var(--text-dim);}

  /* two phones side by side */
  .phones-row{display:flex; gap:40px; justify-content:center; flex-wrap:wrap;}

  /* IG comments style */
  .comments-card{
    background:var(--bg2); border:1px solid #232329; border-radius:16px;
    padding:24px; max-width:520px; margin:0 auto;
  }
  .comments-card .post-header{display:flex; align-items:center; gap:10px; margin-bottom:16px;}
  .comment{display:flex; gap:10px; margin-bottom:16px;}
  .comment .avatar-sm{
    width:30px; height:30px; border-radius:50%; flex-shrink:0;
    background:linear-gradient(135deg,var(--ig1),var(--ig2),var(--ig3));
  }
  .comment .body{font-size:14px;}
  .comment .user{font-weight:600; margin-right:6px;}
  .comment .time{color:var(--text-dim); font-size:11px; margin-top:2px;}
  .comment .likes{color:var(--text-dim); font-size:11px; margin-left:12px;}

  /* offer as checkout screens */
  .offer-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:10px;}
  .offer-card{
    background:var(--bg2); border:1px solid #232329; border-radius:18px;
    padding:26px 22px; text-align:center; position:relative;
  }
  .offer-card.featured{
    border:2px solid var(--gold);
  }
  .offer-card .tag{
    position:absolute; top:-12px; left:50%; transform:translateX(-50%);
    background:var(--gold); color:#1a1400; font-size:11px; font-weight:700;
    padding:4px 14px; border-radius:20px;
  }
  .offer-card h3{font-family:'Fraunces'; font-size:24px; margin-bottom:8px;}
  .offer-card p.desc{font-size:14px; color:var(--text-dim); margin-bottom:20px; min-height:60px;}
  .offer-card .price .old{text-decoration:line-through; color:var(--text-dim); font-size:13px; display:block;}
  .offer-card .price .now{font-size:28px; font-weight:800; margin-bottom:18px; display:block;}
  .offer-btn{
    display:block; background:var(--bubble-me); color:#fff; text-decoration:none;
    padding:12px; border-radius:24px; font-weight:600; font-size:14px;
  }
  .offer-card.featured .offer-btn{background:var(--gold); color:#1a1400;}

  .final{text-align:center; padding:90px 0;}
  .final h2{font-family:'Fraunces'; font-weight:700; font-size:clamp(28px,5vw,44px); margin-bottom:16px;}
  .final p{color:var(--text-dim); max-width:480px; margin:0 auto 30px;}

  footer{text-align:center; padding:26px 0; font-size:12px; color:var(--text-dim); border-top:1px solid #232329;}

  @media(max-width:760px){
    .offer-grid{grid-template-columns:1fr;}
    .phones-row{gap:0;}
  }
</style>
</head>
<body>

<div class="topbar">
